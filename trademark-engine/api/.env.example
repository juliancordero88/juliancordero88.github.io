# ── USPTO / Trademark databases ───────────────────────────────────────────────
# Marker API  → markerapi.com  (primary USPTO source)
MARKER_API_KEY=

# RapidAPI → rapidapi.com  (free tier: 1,000 req/mo, fallback USPTO source)
RAPIDAPI_KEY=

# EUIPO → dev.euipo.europa.eu  (free, register at the EUIPO developer portal)
EUIPO_CLIENT_ID=
EUIPO_CLIENT_SECRET=

# ── Common-law search ─────────────────────────────────────────────────────────
# WhoisXML API → whoisxmlapi.com  (free: 1,000 req, then ~$50+/mo)
WHOISXML_API_KEY=

# OpenCorporates → opencorporates.com  (free for open-data projects)
OPENCORPORATES_API_KEY=

# ── Feature flags ─────────────────────────────────────────────────────────────
# Disable to save ~1.5 GB RAM at startup (falls back to token-overlap scoring)
ENABLE_SEMANTIC=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins. Use "*" for dev; tighten in production.
CORS_ORIGINS=*

# ── Optional Redis cache (docker-compose includes one) ────────────────────────
REDIS_URL=
